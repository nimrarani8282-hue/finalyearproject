<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/topAppBar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/surface_container_lowest" app:title="@string/nav_profile" app:titleTextColor="@color/on_surface" app:navigationIcon="@android:drawable/ic_menu_revert"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <ImageView android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/bg_circle_secondary" android:padding="20dp" android:src="@android:drawable/ic_menu_myplaces" android:layout_marginBottom="12dp"/>
        <TextView android:id="@+id/tvProfileName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seller Name" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/on_surface"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.9 ★ · 24 Reviews" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:layout_marginBottom="20dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="4dp">
            <TextView android:id="@+id/rowEditProfile" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Edit Profile" android:textColor="@color/on_surface" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/rowPaymentMethods" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Payment Methods" android:textColor="@color/on_surface" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/rowSecurity" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Security" android:textColor="@color/on_surface" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/rowLogout" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Logout" android:textColor="@color/error" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>