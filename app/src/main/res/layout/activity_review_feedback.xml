<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/topAppBar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/surface_container_lowest" app:title="@string/review_feedback" app:titleTextColor="@color/on_surface" app:navigationIcon="@android:drawable/ic_menu_revert"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UI Design Refresh - Contract #441" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/on_surface" android:layout_marginBottom="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Freelancer: Alex Rivera" android:textSize="12sp" android:textColor="@color/on_surface_variant" android:layout_marginBottom="16dp"/>
        <RatingBar android:id="@+id/ratingBar" style="?android:attr/ratingBarStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:numStars="5" android:rating="5" android:stepSize="1" android:layout_marginBottom="16dp"/>
        <EditText android:id="@+id/etReviewText" android:layout_width="match_parent" android:layout_height="120dp" android:hint="Share details of your experience" android:gravity="top" android:padding="14dp" android:background="@drawable/bg_rounded_outline" android:layout_marginBottom="20dp"/>
        <TextView android:id="@+id/btnSubmitReview" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Submit Review" android:textColor="@color/on_primary" android:textStyle="bold" android:background="@drawable/bg_pill_primary" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>