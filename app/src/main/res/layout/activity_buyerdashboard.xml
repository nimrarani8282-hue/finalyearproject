<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_container_lowest"
        app:title="Escrow Easy" app:titleTextColor="@color/primary"
        app:navigationIcon="@android:drawable/ic_lock_lock"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="72dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!--  Welcome  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hello_buyer"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buyer_dashboard_subtitle"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="20dp"/>
            <!--  Row 1: Create Transaction (hero, tall) + 2 stacked small cards  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <!--  Create Transaction hero card  -->
                <LinearLayout
                    android:id="@+id/cardCreateTransaction"
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_primary"
                    android:padding="16dp" android:layout_marginEnd="8dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_square_white_translucent"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_input_add"
                        android:layout_marginBottom="12dp"
                        app:tint="@color/on_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_transaction"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_primary"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="@string/create_transaction_desc"
                        android:textSize="12sp"
                        android:textColor="@color/on_primary"
                        android:alpha="0.85"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="→" android:textSize="18sp"
                        android:textColor="@color/on_primary"/>
                </LinearLayout>
                <!--  Small cards stacked  -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/cardPaymentSubmission"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_square_secondary"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_save"
                            android:layout_marginBottom="6dp"
                            app:tint="@color/on_secondary_container" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_submission"
                            android:textSize="12sp" android:textStyle="bold"
                            android:textColor="@color/on_surface"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_submission_desc"
                            android:textSize="10sp"
                            android:textColor="@color/on_surface_variant"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/cardServiceRequest"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp" android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_square_tertiary"
                            android:padding="8dp" android:src="@android:drawable/ic_menu_agenda"
                            android:layout_marginBottom="6dp"
                            app:tint="@color/on_tertiary_fixed" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/service_request"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/service_request_desc"
                            android:textSize="10sp"
                            android:textColor="@color/on_surface_variant"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!--  Confirm Receipt - wide critical action  -->
            <LinearLayout
                android:id="@+id/cardConfirmReceipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_secondary_container"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_secondary"
                    android:padding="12dp" android:src="@android:drawable/ic_menu_help"
                    app:tint="@color/on_secondary_container" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/confirm_receipt"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_secondary_container"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/confirm_receipt_desc"
                        android:textSize="12sp"
                        android:textColor="@color/on_secondary_container"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 PENDING"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary"
                    android:background="@drawable/bg_pill_primary"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"/>
            </LinearLayout>
            <!--  Review & Report row  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:id="@+id/cardReviewFeedback"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="14dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_square_neutral"
                        android:padding="8dp"
                        android:src="@android:drawable/btn_star_big_on"
                        android:layout_marginBottom="6dp"/>
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_feedback"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_feedback_desc"
                        android:textSize="10sp"
                        android:textColor="@color/on_surface_variant"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardReportIssue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_error_container"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_square_neutral"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_dialog_alert"
                        android:layout_marginBottom="6dp"
                        app:tint="@color/error" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_issue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_error_container"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_issue_desc"
                        android:textSize="10sp"
                        android:textColor="@color/on_error_container"/>
                </LinearLayout>
            </LinearLayout>
            <!--  Transaction History  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/transaction_history"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/btnViewAllBuyerTransactions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/view_all"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBuyerTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"/>
            <!--  Protection banner  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/protection_title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxWidth="240dp"
                    android:text="@string/protection_desc"
                    android:textSize="12sp"
                    android:textColor="@color/on_primary"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface_container"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/on_surface_variant"
        app:itemTextColor="@color/on_surface_variant"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>