<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_container_lowest" app:title="@string/create_transaction" app:titleTextColor="@color/on_surface" app:navigationIcon="@android:drawable/ic_menu_revert"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seller Email or Username"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etSeller"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. seller@example.com"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_rounded_outline"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Item / Service Description"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="What are you purchasing?"
                android:gravity="top"
                android:padding="14dp"
                android:background="@drawable/bg_rounded_outline"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount (USD)"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_rounded_outline"
                android:layout_marginBottom="24dp"/>
            <TextView
                android:id="@+id/btnCreateTransactionConfirm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="Create Secure Transaction"
                android:textColor="@color/on_primary"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_primary"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>