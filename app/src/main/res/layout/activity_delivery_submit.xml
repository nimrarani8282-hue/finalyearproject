<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/topAppBar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/surface_container_lowest" app:title="Submit Delivery" app:titleTextColor="@color/on_surface" app:navigationIcon="@android:drawable/ic_menu_revert"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upload your project files for buyer review." android:textColor="@color/on_surface_variant" android:layout_marginBottom="16dp"/>
        <TextView android:id="@+id/btnChooseFile" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Choose Files" android:textColor="@color/primary" android:background="@drawable/bg_button_outline_primary" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"/>
        <EditText android:id="@+id/etDeliveryNote" android:layout_width="match_parent" android:layout_height="120dp" android:hint="Add a note to buyer (optional)" android:gravity="top" android:padding="12dp" android:background="@drawable/bg_rounded_outline" android:layout_marginBottom="16dp"/>
        <TextView android:id="@+id/btnConfirmSubmit" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Confirm Submission" android:textColor="@color/on_primary" android:textStyle="bold" android:background="@drawable/bg_pill_primary" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>