<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/topAppBar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/surface_container_lowest" app:title="@string/nav_wallet" app:titleTextColor="@color/on_surface" app:navigationIcon="@android:drawable/ic_menu_revert"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_primary" android:padding="20dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/available_balance" android:textColor="@color/on_primary" android:alpha="0.8" android:textSize="12sp"/>
            <TextView android:id="@+id/tvWalletBalance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$12,450.00" android:textColor="@color/on_primary" android:textStyle="bold" android:textSize="32sp" android:layout_marginBottom="16dp"/>
            <TextView android:id="@+id/btnWalletWithdraw" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="@string/withdraw_funds" android:textColor="@color/primary" android:textStyle="bold" android:background="@drawable/bg_pill_white" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_card_rounded" android:padding="16dp" android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Escrow Pending" android:textColor="@color/on_surface"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$4,120.00" android:textStyle="bold" android:textColor="@color/on_surface"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_card_rounded" android:padding="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Earned (Lifetime)" android:textColor="@color/on_surface"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$48,900.00" android:textStyle="bold" android:textColor="@color/tertiary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>